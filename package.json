{
  "name": "sluiceway-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bun --bun astro dev",
    "build": "bun --bun astro build",
    "preview": "bun --bun astro preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun --bun astro check",
    "check": "bun run lint && bun run tokens --check && bun run pin && bun run release && bun run typecheck && bun run build && bun run test",
    "lighthouse": "lhci autorun",
    "links": "bun scripts/check-links.ts",
    "pin": "bun scripts/check-pin.ts",
    "release": "bun scripts/check-release.ts",
    "serve": "bun scripts/serve.ts",
    "test": "bun test",
    "tokens": "bun scripts/build-tokens.ts"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.1",
    "@astrojs/sitemap": "3.7.4",
    "@astrojs/starlight": "0.42.2",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "astro": "7.3.3",
    "gemoji": "8.1.0",
    "github-slugger": "2.0.0",
    "satteri": "0.10.5",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@biomejs/biome": "2.5.14",
    "@lhci/cli": "0.15.1",
    "@types/bun": "1.3.14",
    "@types/mdast": "4.0.4",
    "typescript": "6.0.3"
  }
}
