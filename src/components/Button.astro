---
// Button: the design system's button, and the only one on the site. With `href` it is a link,
// without it a `<button type="button">` for a script to handle. One `primary` a row at most.
// Other attributes, such as `data-*` and `aria-label`, pass through. Styles: button.css.
import type { HTMLAttributes } from "astro/types";
import "../styles/button.css";

type Props = Omit<HTMLAttributes<"a"> & HTMLAttributes<"button">, "type"> & {
  href?: string;
  primary?: boolean;
  size?: "sm";
};

const { href, primary = false, size, class: className, ...attrs } = Astro.props;
const classes = [
  "sw-btn",
  "not-content",
  { "sw-btn--primary": primary, "sw-btn--sm": size === "sm" },
  className,
];
---

{
  href ? (
    <a class:list={classes} {href} {...attrs}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...attrs}>
      <slot />
    </button>
  )
}
