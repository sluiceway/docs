---
// Every state Penny draws, one per row: the picture, its file name, and when the dashboard
// shows it. "Shown when" is read from the tables of the action's assets/mascot/README.md at
// the pinned tag, and the build fails if a picture has no row there. A picture with signs
// shows the row of the picture without them and the row of its signs.
import { shownWhen } from "../lib/action-text";
import HeaderPicture from "./HeaderPicture.astro";

interface Props {
  /** File stems from assets/mascot with the state in words, as alt text, for each. */
  pictures: { picture: string; alt: string }[];
}

const { pictures } = Astro.props;
const when = shownWhen(pictures.map(({ picture }) => picture));
---

<ul class="sw-gallery not-content">
  {
    pictures.map(({ picture, alt }) => (
      <li class="sw-gallery__row">
        <HeaderPicture {picture} {alt} />
        <p class="sw-gallery__caption">
          <code>{picture}</code>
          <span>
            <span class="sw-gallery__label">Shown when</span> {when[picture]?.when}
          </span>
          {when[picture]?.signs && (
            <span>
              <span class="sw-gallery__label">With these signs when</span> {when[picture]?.signs}
            </span>
          )}
        </p>
      </li>
    ))
  }
</ul>

<style>
  .sw-gallery {
    display: flex;
    flex-direction: column;
    gap: var(--space-7);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }
  .sw-gallery__row {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
  }
  .sw-gallery__caption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    align-items: baseline;
    margin: 0;
    font-size: 16px;
    line-height: 27px;
  }
  /* `code-sm` */
  .sw-gallery__caption code {
    font-family: var(--font-mono);
    font-size: 12.5px;
    line-height: 20px;
    font-weight: 400;
    white-space: nowrap;
    color: var(--ink);
  }
  /* `label` */
  .sw-gallery__label {
    font-size: 13px;
    line-height: 16px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
</style>
