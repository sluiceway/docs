---
// ConsentBar: asks once whether these docs may count with Umami, and starts analytics on the
// page when the reader has allowed it. The footer's "Analytics settings" reopens it. It never
// shows when the browser sends Do Not Track or Global Privacy Control. Renders nothing while
// analytics is off.
import { ANALYTICS_ENABLED } from "../lib/analytics";
import Button from "./Button.astro";
---

{
  ANALYTICS_ENABLED && (
    <section
      class="sw-consent not-content"
      aria-label="Analytics"
      tabindex="-1"
      data-sw-consent
      hidden
    >
      <p class="sw-consent__text">
        These docs can count page views, searches and clicks with Umami, hosted by the Sluiceway
        maintainer. No cookies. Allow it?
      </p>
      <div class="sw-consent__buttons">
        <Button size="sm" data-consent="allow">
          Allow
        </Button>
        <Button size="sm" data-consent="deny">
          No thanks
        </Button>
      </div>
    </section>
  )
}

<script>
  import { analytics } from "../lib/analytics";
  import { watchEvents } from "../lib/analytics-events";

  const bar = document.querySelector<HTMLElement>("[data-sw-consent]");
  if (analytics && bar) {
    const a = analytics;
    a.init();
    watchEvents(a);

    // Where focus goes back to when the bar was opened from the footer.
    let opener: HTMLElement | null = null;
    // Room under the page while the bar is open, so it never covers the footer for good.
    const pad = () => {
      document.body.style.paddingBottom = bar.hidden ? "" : `${bar.offsetHeight + 32}px`;
    };
    new ResizeObserver(pad).observe(bar);
    const open = (from: HTMLElement | null) => {
      opener = from;
      bar.hidden = false;
      pad();
      if (from) bar.focus();
    };
    const close = () => {
      bar.hidden = true;
      pad();
      opener?.focus();
      opener = null;
    };

    if (!a.blocked() && a.choice() === null) open(null);
    for (const button of bar.querySelectorAll<HTMLButtonElement>("[data-consent]")) {
      button.addEventListener("click", () => {
        a.choose(button.dataset.consent === "allow");
        close();
      });
    }
    for (const settings of document.querySelectorAll<HTMLButtonElement>("[data-sw-consent-open]")) {
      settings.addEventListener("click", () => open(settings));
    }
  }
</script>

<style>
  .sw-consent {
    position: fixed;
    z-index: var(--sl-z-index-navbar);
    inset: auto var(--space-4) var(--space-4) var(--space-4);
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding: var(--space-4) var(--space-5);
    background: var(--surface);
    color: var(--ink);
    border: var(--border-ink) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-pop);
  }
  .sw-consent[hidden] {
    display: none;
  }
  .sw-consent__text {
    flex: 1 1 22rem;
    margin: 0;
    font-size: 15px;
    line-height: 24px;
  }
  .sw-consent__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
