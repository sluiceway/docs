---
// In place of Starlight's icon row: the landing page as a nav link, then GitHub as a small
// quiet icon. It has no outline and no shadow, so Go to console (Header) stays the one thing
// in the bar that looks pressable; the focus ring is the global one. The mark is Octicons'
// mark-github-16 (@primer/octicons 19.38.0), as the design system asks of a true icon.
import { LANDING_URL } from "../../lib/site";
import { REPO_URL } from "../../lib/source";
---

<a class="sw-navlink" href={LANDING_URL} title="The Sluiceway home page">Sluiceway</a>
<a class="sw-icon-link" href={REPO_URL} aria-label="Sluiceway on GitHub">
  <svg aria-hidden="true" viewBox="0 0 16 16" width="18" height="18" fill="currentColor">
    <path
      d="M6.766 11.328c-2.063-.25-3.516-1.734-3.516-3.656 0-.781.281-1.625.75-2.188-.203-.515-.172-1.609.063-2.062.625-.078 1.468.25 1.968.703.594-.187 1.219-.281 1.985-.281.765 0 1.39.094 1.953.265.484-.437 1.344-.765 1.969-.687.218.422.25 1.515.046 2.047.5.593.766 1.39.766 2.203 0 1.922-1.453 3.375-3.547 3.64.531.344.89 1.094.89 1.954v1.625c0 .468.391.734.86.547C13.781 14.359 16 11.53 16 8.03 16 3.61 12.406 0 7.984 0 3.563 0 0 3.61 0 8.031a7.88 7.88 0 0 0 5.172 7.422c.422.156.828-.125.828-.547v-1.25c-.219.094-.5.156-.75.156-1.031 0-1.64-.562-2.078-1.609-.172-.422-.36-.672-.719-.719-.187-.015-.25-.093-.25-.187 0-.188.313-.328.625-.328.453 0 .844.281 1.25.86.313.452.64.655 1.031.655s.641-.14 1-.5c.266-.265.47-.5.657-.656"
    ></path>
  </svg>
</a>

<style>
  .sw-navlink {
    padding: var(--space-2) var(--space-3);
    border: var(--border-ink) solid transparent;
    border-radius: var(--radius-crate);
    font-family: var(--font-sans);
    font-size: 15px;
    line-height: 17px;
    font-weight: 800;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .sw-navlink:hover {
    border-color: var(--line);
    background: var(--surface-sunk);
  }
  .sw-icon-link {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-crate);
    color: var(--ink-muted);
  }
  .sw-icon-link:hover {
    background: var(--surface-sunk);
    color: var(--ink);
  }
  /* A full 44px touch target on a phone. */
  @media (pointer: coarse) {
    .sw-icon-link {
      width: 44px;
      height: 44px;
    }
  }
</style>
