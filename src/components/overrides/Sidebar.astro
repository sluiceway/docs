---
// Starlight's sidebar, with Penny's mark and the pinned version at its foot, linking to the
// start page.
import Default from "@astrojs/starlight/components/Sidebar.astro";
import { page } from "../../lib/routes";
import { VERSION } from "../../lib/source";
import PennyMark from "../PennyMark.astro";
---

<Default />
<a class="sw-sidebar-foot" href={page("")}>
  <PennyMark size={28} />
  <span>Sluiceway v{VERSION}</span>
</a>

<style>
  .sw-sidebar-foot {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-6);
    padding: var(--space-4) 0 var(--space-2);
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
    font-weight: 500;
    color: var(--ink-muted);
    text-decoration: none;
  }
  .sw-sidebar-foot:hover span {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
