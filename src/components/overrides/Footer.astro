---
// Replaces Starlight's footer: the page's source line, then the Footer slab.
import Pagination from "@astrojs/starlight/components/Pagination.astro";
import { LANDING_URL } from "../../lib/site";
import { pageSource, REPO_URL, TAG, VERSION } from "../../lib/source";
import ConsentBar from "../ConsentBar.astro";
import Feedback from "../Feedback.astro";
import SiteFooter from "../Footer.astro";

const { entry, id } = Astro.locals.starlightRoute;
const splash = entry.data.template === "splash";
// The thumbs end every docs page, not the landing page or the 404.
const feedback = !splash && id !== "" && id !== "404";
const source = pageSource(entry.data.source, entry.filePath ?? `src/content/docs/${entry.id}`);
---

<footer class="sw-page-footer">
  {/* The landing page ends on its own "Where to go next", not on the docs' page furniture. */}
  {!splash && <Pagination />}
  {feedback && <Feedback />}
  {
    !splash && (
      <p class="sw-source">
        Source: <a href={source.href}><code>{source.path}</code> at <code>{source.ref}</code></a>
      </p>
    )
  }
  <SiteFooter
    version={VERSION}
    links={[
      { label: "Sluiceway", href: LANDING_URL },
      { label: "GitHub", href: REPO_URL },
      { label: "Changelog", href: `${import.meta.env.BASE_URL.replace(/\/$/, "")}/changelog/` },
      { label: `Release ${TAG}`, href: `${REPO_URL}/releases/tag/${TAG}` },
    ]}
  />
  <ConsentBar />
</footer>

<style>
  .sw-page-footer {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    margin-top: var(--space-8);
  }
  .sw-source {
    margin: 0;
    font-size: 14px;
    line-height: 22px;
    color: var(--ink-muted);
  }
  .sw-source a {
    color: var(--ink-muted);
    text-underline-offset: 3px;
  }
  .sw-source code {
    font-family: var(--font-mono);
    font-size: 12.5px;
  }
</style>
