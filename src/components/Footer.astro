---
// Footer: the ink slab that closes every page: Penny's mark beside the wordmark, the links,
// and the note with the version and the licence. The slab is ink in both themes, so the mark
// is the dark file in both.
import { WAITLIST_URL } from "../lib/site";
import AnalyticsNote from "./AnalyticsNote.astro";
import PennyMark from "./PennyMark.astro";

interface Props {
  version: string;
  links: { label: string; href: string }[];
}

const { version, links } = Astro.props;
---

<div class="sw-footer not-content">
  <p class="sw-footer__brand">
    <PennyMark size={34} onInk />
    <span translate="no">sluiceway</span>
  </p>
  <nav class="sw-footer__links" aria-label="Footer">
    {links.map(({ label, href }) => <a {href}>{label}</a>)}
  </nav>
  {
    WAITLIST_URL && (
      <p class="sw-footer__note">
        <a href={WAITLIST_URL} data-analytics-event="waitlist-click">A hosted version of Sluiceway is planned.</a>
      </p>
    )
  }
  <p class="sw-footer__note">Sluiceway v{version} &middot; Apache-2.0</p>
  <AnalyticsNote />
</div>
