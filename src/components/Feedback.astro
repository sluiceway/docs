---
// Feedback: "Was this page useful?" with a thumb up and a thumb down, at the end of every docs
// page. An answer is one `feedback` event. With analytics off, or not allowed, the reply says
// that nothing was sent.
import Button from "./Button.astro";
---

<section class="sw-feedback not-content" aria-labelledby="sw-feedback-q" data-sw-feedback hidden>
  <h2 id="sw-feedback-q" class="sw-feedback__q">Was this page useful?</h2>
  <div class="sw-feedback__buttons" data-buttons>
    {/* The thumbs are GitHub's Octicons thumbsup-16 and thumbsdown-16 (v19.38.0, MIT). */}
    <Button size="sm" data-vote="up" aria-label="Yes, it was useful">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8.347.631A.75.75 0 0 1 9.123.26l.238.04a3.25 3.25 0 0 1 2.591 4.098L11.494 6h.665a3.25 3.25 0 0 1 3.118 4.167l-1.135 3.859A2.751 2.751 0 0 1 11.503 16H6.586a3.75 3.75 0 0 1-2.184-.702A1.75 1.75 0 0 1 3 16H1.75A1.75 1.75 0 0 1 0 14.25v-6.5C0 6.784.784 6 1.75 6h3.417a.25.25 0 0 0 .217-.127ZM4.75 13.649l.396.33c.404.337.914.521 1.44.521h4.917a1.25 1.25 0 0 0 1.2-.897l1.135-3.859A1.75 1.75 0 0 0 12.159 7.5H10.5a.75.75 0 0 1-.721-.956l.731-2.558a1.75 1.75 0 0 0-1.127-2.14L6.69 6.611a1.75 1.75 0 0 1-1.523.889H4.75ZM3.25 7.5h-1.5a.25.25 0 0 0-.25.25v6.5c0 .138.112.25.25.25H3a.25.25 0 0 0 .25-.25Z"></path>
      </svg>
    </Button>
    <Button size="sm" data-vote="down" aria-label="No, it was not useful">
      <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M7.653 15.369a.75.75 0 0 1-.776.371l-.238-.04a3.25 3.25 0 0 1-2.591-4.099L4.506 10h-.665A3.25 3.25 0 0 1 .723 5.833l1.135-3.859A2.75 2.75 0 0 1 4.482 0H9.43c.78.003 1.538.25 2.168.702A1.752 1.752 0 0 1 12.989 0h1.272A1.75 1.75 0 0 1 16 1.75v6.5A1.75 1.75 0 0 1 14.25 10h-3.417a.25.25 0 0 0-.217.127ZM11.25 2.351l-.396-.33a2.248 2.248 0 0 0-1.44-.521H4.496a1.25 1.25 0 0 0-1.199.897L2.162 6.256A1.75 1.75 0 0 0 3.841 8.5H5.5a.75.75 0 0 1 .721.956l-.731 2.558a1.75 1.75 0 0 0 1.127 2.14L9.31 9.389a1.75 1.75 0 0 1 1.523-.889h.417Zm1.5 6.149h1.5a.25.25 0 0 0 .25-.25v-6.5a.25.25 0 0 0-.25-.25H13a.25.25 0 0 0-.25.25Z"></path>
      </svg>
    </Button>
  </div>
  <p class="sw-feedback__reply" role="status" tabindex="-1" data-reply></p>
</section>

<script>
  import { analytics } from "../lib/analytics";

  const section = document.querySelector<HTMLElement>("[data-sw-feedback]");
  if (section) {
    // The buttons need this script, so the section stays hidden without it.
    section.hidden = false;
    const buttons = section.querySelector<HTMLElement>("[data-buttons]");
    const reply = section.querySelector<HTMLElement>("[data-reply]");
    for (const button of section.querySelectorAll<HTMLButtonElement>("[data-vote]")) {
      button.addEventListener("click", () => {
        const sent =
          analytics?.track("feedback", {
            path: location.pathname,
            vote: button.dataset.vote ?? "",
          }) ?? false;
        const hadFocus = buttons?.contains(document.activeElement);
        if (buttons) buttons.hidden = true;
        if (reply) {
          reply.textContent = sent ? "Thanks." : "Thanks. Analytics is off, so this was not sent.";
          // The pressed button is gone, so keyboard focus moves to the reply.
          if (hadFocus) reply.focus();
        }
      });
    }
  }
</script>

<style>
  .sw-feedback {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-5);
    border-top: 1px solid var(--line-soft);
  }
  .sw-feedback[hidden],
  .sw-feedback__buttons[hidden] {
    display: none;
  }
  .sw-feedback__q {
    margin: 0;
    font-size: 17px;
    line-height: 24px;
    font-weight: 700;
    color: var(--ink);
  }
  .sw-feedback__buttons {
    display: flex;
    gap: var(--space-3);
  }
  .sw-feedback__reply {
    margin: 0;
    font-size: 16px;
    line-height: 27px;
    color: var(--ink);
  }
  .sw-feedback__reply:empty {
    display: none;
  }
</style>
