---
// The README's example dashboard inside a frame that reads as a GitHub issue: its title, an
// "Open" state and the `sluiceway` label, over the body the action's renderer wrote. The
// body is styled after the way github.com renders an issue body, with the site's tokens, so
// it follows both themes. The header picture comes from the submodule at the pinned tag.
import { exampleDashboard } from "../lib/example-dashboard";
import HeaderPicture from "./HeaderPicture.astro";

const dashboard = exampleDashboard();
---

<figure class="sw-issue not-content" aria-labelledby="sw-issue-title">
  <div class="sw-issue__head">
    <p class="sw-issue__title" id="sw-issue-title">Sluiceway dashboard</p>
    <p class="sw-issue__meta">
      <span class="sw-issue__state">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="2"></circle>
          <circle cx="8" cy="8" r="1.5" fill="currentColor"></circle>
        </svg>
        Open
      </span>
      <span class="sw-issue__label">sluiceway</span>
    </p>
  </div>
  <div class="sw-issue__body">
    <HeaderPicture picture={dashboard.picture} alt={dashboard.alt} eager />
    <Fragment set:html={dashboard.html} />
  </div>
</figure>

<style>
  .sw-issue {
    margin: var(--space-7) 0 0;
    background: var(--surface);
    color: var(--ink);
    border: var(--border-ink) solid var(--line);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-pop);
    overflow: hidden;
  }
  .sw-issue__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
    background: var(--surface-sunk);
    border-bottom: var(--border-ink) solid var(--line);
  }
  .sw-issue__head p {
    margin: 0;
  }
  .sw-issue__title {
    font-size: 20px;
    line-height: 27px;
    font-weight: 700;
  }
  .sw-issue__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  /* The state and the label are drawn in ink: a signal colour here would say a stack state. */
  .sw-issue__state,
  .sw-issue__label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: 2px var(--space-3);
    border: var(--border-ink) solid var(--line);
    border-radius: var(--radius-pill);
    font-size: 14px;
    line-height: 20px;
    font-weight: 700;
  }
  .sw-issue__state {
    background: var(--ink);
    color: var(--ink-invert);
  }
  .sw-issue__label {
    background: var(--surface);
    font-family: var(--font-mono);
    font-weight: 500;
  }

  /* The body, after github.com's rendering of an issue body. */
  .sw-issue__body {
    padding: var(--space-5);
    font-size: 15px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .sw-issue__body :global(> * + *) {
    margin-top: var(--space-4);
  }
  .sw-issue__body :global([align="center"]) {
    text-align: center;
  }
  .sw-issue__body :global(p),
  .sw-issue__body :global(ul) {
    margin-block: 0;
  }
  .sw-issue__body :global(div > p + p) {
    margin-top: var(--space-4);
  }
  .sw-issue__body :global(h3) {
    margin: var(--space-6) 0 var(--space-4);
    font-size: 20px;
    line-height: 1.25;
    font-weight: 700;
    color: var(--ink);
  }
  .sw-issue__body :global(ul) {
    padding-left: 2em;
  }
  .sw-issue__body :global(li + li) {
    margin-top: 0.25em;
  }
  .sw-issue__body :global(ul.contains-task-list) {
    list-style: none;
    padding-left: 0;
  }
  .sw-issue__body :global(.task-list-item > input) {
    margin: 0 0.2em 0.25em 0;
    vertical-align: middle;
  }
  .sw-issue__body :global(summary) {
    cursor: pointer;
  }
  .sw-issue__body :global(a) {
    color: var(--water-deep);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .sw-issue__body :global(code) {
    padding: 0.2em 0.4em;
    font-family: var(--font-mono);
    font-size: 85%;
    background: var(--surface-sunk);
    border-radius: 6px;
    white-space: break-spaces;
  }
  .sw-issue__body :global(kbd) {
    display: inline-block;
    padding: 0 5px;
    font-family: var(--font-mono);
    font-size: 11px;
    line-height: 18px;
    vertical-align: middle;
    color: var(--ink);
    background: var(--surface-sunk);
    border: 1px solid var(--line-soft);
    border-bottom-color: var(--line-soft);
    border-radius: 6px;
    box-shadow: inset 0 -1px 0 var(--line-soft);
  }
  .sw-issue__body :global(sub) {
    font-size: 75%;
  }
  .sw-issue__body :global(hr) {
    height: 4px;
    margin: var(--space-6) 0;
    padding: 0;
    background: var(--line-soft);
    border: 0;
  }
  .sw-issue__body :global(.sw-header-picture) {
    margin: 0;
  }
</style>
