---
// AnalyticsNote: the footer's line on what is counted, linking the privacy page. Renders
// nothing while analytics is off.
import { ANALYTICS_ENABLED } from "../lib/analytics";

const privacy = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/privacy/`;
---

{
  ANALYTICS_ENABLED && (
    <p class="sw-footer__note sw-analytics-note">
      Self-hosted Umami counts page views, searches, copied code, page feedback and clicks on
      links to other sites. No cookies, and nothing is stored in your browser.{" "}
      <a href={privacy}>Privacy</a>
      <span class="sw-analytics-note__blocked" hidden>
        {" "}Your browser sends Do Not Track, so nothing is counted.
      </span>
    </p>
  )
}

<script>
  import { analytics } from "../lib/analytics";

  if (analytics?.blocked()) {
    for (const note of document.querySelectorAll(".sw-analytics-note__blocked")) {
      note.removeAttribute("hidden");
    }
  }
</script>

<style>
  .sw-analytics-note [hidden] {
    display: none;
  }
</style>
