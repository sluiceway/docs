---
// Card: a framed block. `bar` for a card that stands for a thing the product does. Tilt at
// most two cards a section, as a left and right pair, and never one holding code or a table.
interface Props {
  title?: string;
  bar?: boolean;
  tone?: "warm" | "cool";
  hero?: boolean;
  tilt?: "left" | "right";
  /** Makes the whole card a link: the title is the link text, and the card shows its focus. */
  href?: string;
}

const { title, bar = false, tone, hero = false, tilt, href } = Astro.props;
---

<div
  class:list={[
    "sw-card",
    "not-content",
    tone && `sw-card--${tone}`,
    tilt && `sw-card--${tilt}`,
    { "sw-card--hero": hero, "sw-card--barred": bar, "sw-card--link": href },
  ]}
>
  {bar && <div class="sw-card__bar" />}
  {
    title && (
      <p class="sw-card__title">
        {href ? (
          <a class="sw-card__link" {href}>
            {title}
          </a>
        ) : (
          title
        )}
      </p>
    )
  }
  <div class="sw-card__body"><slot /></div>
</div>
