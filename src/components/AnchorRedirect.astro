---
// AnchorRedirect: on a page whose headings moved, sends a link with an old fragment on to where
// that text lives now (src/lib/anchor-redirects.ts). Renders nothing on any other page.
import { ANCHOR_REDIRECTS } from "../lib/anchor-redirects";
import { page } from "../lib/routes";
import { scriptJson } from "../lib/structured-data";

interface Props {
  /** The page id, as in src/lib/pages.ts. */
  id: string;
}

const moved = ANCHOR_REDIRECTS[Astro.props.id];
const map = moved
  ? Object.fromEntries(Object.entries(moved).map(([from, to]) => [from, page(to)]))
  : undefined;
---

{map && <script type="application/json" id="sw-anchor-redirects" set:html={scriptJson(map)} />}

<script>
  import { redirectFor } from "../lib/anchor-redirects";

  const data = document.getElementById("sw-anchor-redirects")?.textContent;
  if (data) {
    const map = JSON.parse(data) as Record<string, string>;
    const go = () => {
      const to = redirectFor(location.hash, map, (id) => document.getElementById(id) !== null);
      if (to) location.replace(to);
    };
    go();
    addEventListener("hashchange", go);
  }
</script>
