---
// HeaderPicture: one of Penny's header pictures from the action's assets/mascot, at the pinned
// tag. The files are served from the submodule at build time, so the picture on the page is
// the file the build checked, and nothing loads from raw.githubusercontent.com (which serves
// SVG as text/plain, so an <img> cannot show it).
//
// The light and dark files swap with Starlight's data-theme and with prefers-color-scheme. A
// <picture> with <source media> can only follow the system setting, not the site's theme
// switch, so both files are in the markup and CSS shows one. The hidden one is not fetched.
import { existsSync } from "node:fs";
import { vendorPath } from "../lib/source";

interface Props {
  /** A file stem from assets/mascot, such as `in-sync`, `pending-4-destroys` or `first-run`. */
  picture: string;
  /** The state in words, such as "4 stacks are pending, some delete or replace resources". */
  alt: string;
  width?: number;
  /** Load at once, for the first picture on a page. Every other picture loads lazily. */
  eager?: boolean;
}

const { picture, alt, width = 880, eager = false } = Astro.props;
const loading = eager ? "eager" : "lazy";

const files = import.meta.glob<string>("/vendor/sluiceway/assets/mascot/*.svg", {
  eager: true,
  query: "?url",
  import: "default",
});

function url(theme: "light" | "dark"): string {
  const file = `assets/mascot/${picture}-${theme}.svg`;
  const src = files[`/vendor/sluiceway/${file}`];
  if (!existsSync(vendorPath(file)) || !src) {
    throw new Error(
      `HeaderPicture: vendor/sluiceway/${file} does not exist at the pinned tag. ` +
        `Use a stem from vendor/sluiceway/assets/mascot, such as "in-sync" or "pending-4".`,
    );
  }
  return src;
}

const light = url("light");
const dark = url("dark");
const height = Math.round((width * 160) / 880);
---

<div class="sw-header-picture not-content">
  <img class="sw-pic-light" src={light} {alt} {width} {height} {loading} decoding="async" />
  <img class="sw-pic-dark" src={dark} {alt} {width} {height} {loading} decoding="async" />
</div>
