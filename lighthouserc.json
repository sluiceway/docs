{
  "ci": {
    "collect": {
      "startServerCommand": "DOCS_BASE=/ bun scripts/serve.ts",
      "startServerReadyPattern": "Serving",
      "url": [
        "http://localhost:4321/",
        "http://localhost:4321/get-started/",
        "http://localhost:4321/guides/workflow/",
        "http://localhost:4321/guides/configuration/",
        "http://localhost:4321/guides/notifications/",
        "http://localhost:4321/guides/policies/",
        "http://localhost:4321/reference/sluiceway-yaml/",
        "http://localhost:4321/reference/what-sluiceway-writes/",
        "http://localhost:4321/using-the-dashboard/",
        "http://localhost:4321/what-it-looks-like/",
        "http://localhost:4321/the-header/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true },
        "chromeFlags": "--no-sandbox"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:accessibility": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:best-practices": ["error", { "minScore": 0.9, "aggregationMethod": "median" }],
        "categories:seo": ["error", { "minScore": 0.9, "aggregationMethod": "median" }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
